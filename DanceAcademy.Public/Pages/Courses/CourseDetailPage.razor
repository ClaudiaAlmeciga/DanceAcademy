@page "/cursos/{CourseId:guid}"

@inject PublicApiService Api

<PageTitle>@(course?.Title ?? "Curso") — Dance Academy</PageTitle>

<div class="container py-5">
    <div class="mb-3">
        <a href="/cursos" class="text-decoration-none text-muted small">← Volver al catálogo</a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (course is null)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Curso no encontrado o no disponible.</p>
        </div>
    }
    else
    {
        <span class="badge badge-level mb-2">@course.LevelName</span>
        <span class="badge bg-light text-dark border mb-2 ms-1">@PricingLabel(course.PricingType, course.Price)</span>
        <h2 class="fw-bold mb-2">@course.Title</h2>
        @if (!string.IsNullOrWhiteSpace(course.Description))
        {
            <p class="text-muted mb-4">@course.Description</p>
        }

        @if (course.SubscriptionPlans.Any())
        {
            <p class="text-muted small mb-4">
                Incluido en: @string.Join(", ", course.SubscriptionPlans.Select(p => p.Name))
                — <a href="/planes">ver planes</a>
            </p>
        }

        <div class="mb-4">
            @if (isAuthenticated)
            {
                @if (isEnrolled)
                {
                    <span class="badge bg-success mb-2">✓ Ya estás inscrito en este curso</span>
                    @if (progress is not null)
                    {
                        <div class="mt-2" style="max-width: 400px;">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Tu avance</span>
                                <span>@progress.CompletedLessons de @progress.TotalLessons lecciones (@progress.ProgressPercentage.ToString("0.#")%)</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @(progress.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                    }
                }
                else if (course.PricingType == PricingType.Free)
                {
                    @if (enrollError is not null)
                    {
                        <div class="alert alert-danger py-2 small mb-2">@enrollError</div>
                    }
                    <button class="btn btn-primary" disabled="@isEnrolling" @onclick="HandleEnrollAsync">
                        @(isEnrolling ? "Inscribiendo..." : "Inscribirme")
                    </button>
                }
                else
                {
                    <span class="badge bg-light text-dark border">Inscripción disponible próximamente (pago)</span>
                }
            }
            else
            {
                <a href="/login" class="btn btn-outline-primary btn-sm">Inicia sesión para inscribirte</a>
            }
        </div>

        @if (!course.Modules.Any())
        {
            <p class="text-muted">Este curso todavía no tiene contenido publicado.</p>
        }
        else
        {
            @foreach (var module in course.Modules)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header fw-semibold">
                        @module.Order. @module.Title
                    </div>
                    <div class="card-body py-2">
                        @if (!module.Lessons.Any())
                        {
                            <div class="text-muted small py-2">Sin lecciones publicadas aún.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var lesson in module.Lessons)
                                {
                                    var isCompleted = completedLessonIds.Contains(lesson.Id);
                                    <li class="list-group-item px-0 @(isCompleted ? "list-group-item-success" : "")">
                                        <a href="/cursos/@CourseId/lecciones/@lesson.Id" class="text-decoration-none d-flex justify-content-between align-items-center">
                                            <span>
                                                @lesson.Order. @lesson.Title
                                                @if (lesson.HasVideo)
                                                {
                                                    <span class="text-muted small ms-1">▶</span>
                                                }
                                            </span>
                                            @if (isCompleted)
                                            {
                                                <span>✓</span>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public Guid CourseId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private CourseDetailDto? course;
    private CourseProgressDto? progress;
    private HashSet<Guid> completedLessonIds = [];
    private bool isLoading = true;
    private bool isAuthenticated;
    private bool isEnrolled;
    private bool isEnrolling;
    private string? enrollError;

    protected override async Task OnInitializedAsync()
    {
        course = await Api.GetCourseDetailAsync(CourseId);
        isLoading = false;

        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }

        if (isAuthenticated)
        {
            var myEnrollments = await Api.GetMyEnrollmentsAsync();
            isEnrolled = myEnrollments?.Any(e => e.CourseId == CourseId) ?? false;

            if (isEnrolled)
                await LoadProgressAsync();
        }
    }

    private async Task LoadProgressAsync()
    {
        progress = await Api.GetCourseProgressAsync(CourseId);

        var lessonProgress = await Api.GetCourseLessonProgressAsync(CourseId);
        completedLessonIds = lessonProgress?.Where(l => l.IsCompleted).Select(l => l.LessonId).ToHashSet() ?? [];
    }

    private async Task HandleEnrollAsync()
    {
        isEnrolling = true;
        enrollError = null;

        var (success, error) = await Api.EnrollInCourseAsync(CourseId);

        isEnrolling = false;

        if (success)
        {
            isEnrolled = true;
            await LoadProgressAsync();
        }
        else
        {
            enrollError = error;
        }
    }

    private static string PricingLabel(PricingType pricingType, decimal? price) => pricingType switch
    {
        PricingType.Free => "Gratis",
        PricingType.SubscriptionIncluded => "Incluido en suscripción",
        PricingType.IndividualPurchase => $"${price:N0}",
        PricingType.Both => $"${price:N0} o suscripción",
        _ => ""
    };
}
