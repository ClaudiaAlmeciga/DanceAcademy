@page "/eventos"

@inject PublicApiService Api

<PageTitle>Eventos — Dance Academy</PageTitle>

<div class="container py-5">
    <Breadcrumb Items="@(new List<BreadcrumbItem> { new("Inicio", "/"), new("Eventos", null) })" />
    <h2 class="fw-bold mb-2">Próximos eventos</h2>
    <p class="text-muted mb-4">Vive la danza más allá de las clases: talleres, muestras y noches abiertas.</p>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (events is null || events.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Todavía no hay eventos programados. ¡Vuelve pronto!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in events)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="da-course-card">
                        @if (!string.IsNullOrWhiteSpace(ev.ImageUrl))
                        {
                            <img src="@ev.ImageUrl" alt="@ev.Title" class="w-100" style="height: 160px; object-fit: cover;" />
                        }
                        <div class="da-course-card-body">
                            <span class="badge bg-light text-dark border mb-2">@ev.EventDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            <h5 class="da-course-title">@ev.Title</h5>
                            @if (!string.IsNullOrWhiteSpace(ev.Location))
                            {
                                <p class="text-muted small mb-2">📍 @ev.Location</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(ev.Description))
                            {
                                <p class="da-course-description text-muted">@ev.Description</p>
                            }
                            <p class="fw-semibold mb-0">$@ev.Price.ToString("N0")</p>
                            <p class="text-muted small mb-0">
                                @(ev.AvailableSpots > 0 ? $"{ev.AvailableSpots} cupos disponibles" : "Cupo lleno")
                            </p>
                        </div>
                        <div class="da-course-card-footer">
                            <a href="/eventos/@ev.Id" class="btn btn-primary btn-sm w-100">Ver detalle</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<EventDto>? events;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        events = await Api.GetEventsAsync();
        isLoading = false;
    }
}
