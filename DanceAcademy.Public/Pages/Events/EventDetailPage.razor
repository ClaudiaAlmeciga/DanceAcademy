@page "/eventos/{EventId:guid}"

@inject PublicApiService Api

<PageTitle>@(ev?.Title ?? "Evento") — Dance Academy</PageTitle>

<div class="container py-5">
    <Breadcrumb Items="@(new List<BreadcrumbItem> { new("Inicio", "/"), new("Eventos", "/eventos"), new(ev?.Title ?? "Evento", null) })" />

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (ev is null)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Evento no encontrado o no disponible.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(ev.ImageUrl))
        {
            <img src="@ev.ImageUrl" alt="@ev.Title" class="img-fluid rounded mb-3" style="max-height: 420px; object-fit: cover; width: 100%;" />
        }
        <span class="badge bg-light text-dark border mb-2">@ev.EventDate.ToLocalTime().ToString("dddd dd 'de' MMMM, HH:mm", CultureInfo)</span>
        <h2 class="fw-bold mb-2">@ev.Title</h2>
        @if (!string.IsNullOrWhiteSpace(ev.Location))
        {
            <p class="text-muted mb-2">📍 @ev.Location</p>
        }
        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <p class="mb-4">@ev.Description</p>
        }

        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="fs-4 fw-bold">$@ev.Price.ToString("N0")</span>
            <span class="text-muted small">
                @(ev.AvailableSpots > 0 ? $"{ev.AvailableSpots} de {ev.Capacity} cupos disponibles" : "Cupo lleno")
            </span>
        </div>

        @if (isAuthenticated)
        {
            @if (myRegistration is not null)
            {
                @if (myRegistration.Status == EventRegistrationStatus.Paid)
                {
                    <span class="badge bg-success">✓ Ya estás inscrito y tu pago está confirmado</span>
                }
                else
                {
                    <div class="alert alert-warning py-2 small" style="max-width: 500px;">
                        ✓ Ya estás inscrito. Tu inscripción está <strong>pendiente de pago</strong> — coordina el pago
                        con la academia para confirmar tu cupo.
                    </div>
                }
            }
            else if (ev.AvailableSpots <= 0)
            {
                <span class="badge bg-secondary">Este evento ya no tiene cupo disponible</span>
            }
            else
            {
                @if (registerError is not null)
                {
                    <div class="alert alert-danger py-2 small mb-2">@registerError</div>
                }
                <button class="btn btn-primary" disabled="@isRegistering" @onclick="HandleRegisterAsync">
                    @(isRegistering ? "Inscribiendo..." : "Inscribirme al evento")
                </button>
            }
        }
        else
        {
            <a href="/login" class="btn btn-outline-primary btn-sm">Inicia sesión para inscribirte</a>
        }
    }
</div>

@code {
    [Parameter] public Guid EventId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly System.Globalization.CultureInfo CultureInfo = new("es-ES");

    private EventDto? ev;
    private MyEventRegistrationDto? myRegistration;
    private bool isLoading = true;
    private bool isAuthenticated;
    private bool isRegistering;
    private string? registerError;

    protected override async Task OnInitializedAsync()
    {
        ev = await Api.GetEventDetailAsync(EventId);
        isLoading = false;

        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }

        if (isAuthenticated)
        {
            var myRegistrations = await Api.GetMyEventRegistrationsAsync();
            myRegistration = myRegistrations?.FirstOrDefault(r => r.EventId == EventId);
        }
    }

    private async Task HandleRegisterAsync()
    {
        isRegistering = true;
        registerError = null;

        var (success, error) = await Api.RegisterForEventAsync(EventId);

        isRegistering = false;

        if (success)
        {
            var myRegistrations = await Api.GetMyEventRegistrationsAsync();
            myRegistration = myRegistrations?.FirstOrDefault(r => r.EventId == EventId);
            ev = await Api.GetEventDetailAsync(EventId);
        }
        else
        {
            registerError = error;
        }
    }
}
