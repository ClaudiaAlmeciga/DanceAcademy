@page "/"

<PageTitle>Dance Academy — Aprende a bailar</PageTitle>

<!-- Hero -->
<section class="da-hero">
    <div class="container text-center">
        <h1 class="da-hero-title">Descubre el arte del baile</h1>
        <p class="da-hero-subtitle">
            Aprende desde cero con instructores expertos.<br />
            Cursos estructurados para todos los niveles.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a href="/cursos" class="btn btn-light btn-lg da-hero-btn">Ver cursos</a>
            <a href="/register" class="btn btn-outline-light btn-lg da-hero-btn">Registrarse gratis</a>
        </div>
    </div>
</section>

<!-- Características -->
<section class="da-features">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="da-feature-card text-center">
                    <div class="da-feature-icon">♪</div>
                    <h5>Cursos estructurados</h5>
                    <p class="text-muted">Módulos y lecciones organizados para que avances paso a paso.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="da-feature-card text-center">
                    <div class="da-feature-icon">★</div>
                    <h5>Todos los niveles</h5>
                    <p class="text-muted">Desde principiante hasta avanzado. Empieza donde estés.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="da-feature-card text-center">
                    <div class="da-feature-icon">▶</div>
                    <h5>A tu ritmo</h5>
                    <p class="text-muted">Aprende cuando quieras, desde cualquier dispositivo.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA final -->
<section class="da-cta">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">¿Listo para empezar?</h2>
        <p class="text-muted mb-4">Únete a nuestra comunidad y comienza tu primer curso hoy.</p>
        <a href="/register" class="btn btn-primary btn-lg">Crear cuenta gratis</a>
    </div>
</section>
