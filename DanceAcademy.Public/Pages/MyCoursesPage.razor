@page "/mis-cursos"
@attribute [Authorize]

@inject PublicApiService Api

<PageTitle>Mis Cursos — Dance Academy</PageTitle>

<div class="container py-5">
    <h2 class="fw-bold mb-4">Mis cursos</h2>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (enrollments is null || enrollments.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5 mb-3">Todavía no estás inscrito en ningún curso.</p>
            <a href="/cursos" class="btn btn-primary">Explorar catálogo</a>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-auto">
                <div class="da-feature-card text-center px-4">
                    <div class="fs-3 fw-bold">@(dashboard?.EnrolledCoursesCount ?? enrollments.Count)</div>
                    <div class="text-muted small">Cursos inscritos</div>
                </div>
            </div>
            <div class="col-auto">
                <div class="da-feature-card text-center px-4">
                    <div class="fs-3 fw-bold">@(dashboard?.OverallProgressPercentage.ToString("0.#") ?? "0")%</div>
                    <div class="text-muted small">Avance general</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var enrollment in enrollments)
            {
                var courseProgress = dashboard?.Courses.FirstOrDefault(c => c.CourseId == enrollment.CourseId);

                <div class="col-lg-4 col-md-6">
                    <div class="da-course-card">
                        <div class="da-course-card-body">
                            <h5 class="da-course-title">@enrollment.CourseTitle</h5>
                            <p class="text-muted small mb-2">
                                Inscrito el @enrollment.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy")
                            </p>
                            @if (courseProgress is not null)
                            {
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Avance</span>
                                    <span>@courseProgress.CompletedLessons/@courseProgress.TotalLessons (@courseProgress.ProgressPercentage.ToString("0.#")%)</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width: @(courseProgress.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                            }
                        </div>
                        <div class="da-course-card-footer d-flex flex-column gap-2">
                            <a href="/cursos/@enrollment.CourseId" class="btn btn-primary btn-sm w-100">Ir al curso →</a>
                            @if (courseProgress is not null && courseProgress.ProgressPercentage >= 100)
                            {
                                <a href="/certificados/@enrollment.CourseId" class="btn btn-outline-primary btn-sm w-100">🎓 Ver certificado</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<EnrollmentDto>? enrollments;
    private MyDashboardDto? dashboard;
    private string? loadError;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            enrollments = await Api.GetMyEnrollmentsAsync();
            if (enrollments is null)
            {
                loadError = "No se pudieron cargar tus cursos.";
                return;
            }

            if (enrollments.Count > 0)
                dashboard = await Api.GetMyDashboardAsync();
        }
        catch
        {
            loadError = "No se pudieron cargar tus cursos.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
