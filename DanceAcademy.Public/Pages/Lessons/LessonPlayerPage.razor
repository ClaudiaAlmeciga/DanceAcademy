@page "/cursos/{CourseId:guid}/lecciones/{LessonId:guid}"

@inject PublicApiService Api

<PageTitle>@(lesson?.Title ?? "Lección") — Dance Academy</PageTitle>

<div class="container py-5" style="max-width: 900px;">
    <div class="mb-3">
        <a href="/cursos/@CourseId" class="text-decoration-none text-muted small">← Volver al curso</a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (lesson is null)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Lección no encontrada o no disponible.</p>
        </div>
    }
    else
    {
        <h3 class="fw-bold mb-3">@lesson.Title</h3>

        @if (lesson.EmbedUrl is not null)
        {
            @if (lesson.IsDirectVideo)
            {
                <video class="w-100 rounded mb-4" style="max-height: 500px;" controls preload="metadata">
                    <source src="@lesson.EmbedUrl" />
                </video>
            }
            else
            {
                <div class="ratio ratio-16x9 mb-4">
                    <iframe src="@lesson.EmbedUrl"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            class="rounded border-0"></iframe>
                </div>
            }
        }
        else
        {
            <div class="alert alert-secondary">Esta lección no tiene video.</div>
        }

        @if (!string.IsNullOrWhiteSpace(lesson.Content))
        {
            <p class="mt-3">@lesson.Content</p>
        }
    }
</div>

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public Guid LessonId { get; set; }

    private LessonDetailDto? lesson;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        lesson = await Api.GetLessonDetailAsync(LessonId);
        isLoading = false;
    }
}
