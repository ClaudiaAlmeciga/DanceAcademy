@page "/cursos/{CourseId:guid}/lecciones/{LessonId:guid}"
@implements IAsyncDisposable

@inject PublicApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(lesson?.Title ?? "Lección") — Dance Academy</PageTitle>

<div class="container py-5">
    <div class="mb-3">
        <a href="/cursos/@CourseId" class="text-decoration-none text-muted small">← Volver al curso</a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (lesson is null)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Lección no encontrada o no disponible.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <h3 class="fw-bold mb-3">@lesson.Title</h3>

                @if (lesson.RequiresEnrollment)
                {
                    <div class="alert alert-warning">
                        Debes inscribirte en el curso para ver esta lección.
                        <a href="/cursos/@CourseId" class="alert-link">Ir al curso para inscribirme →</a>
                    </div>
                }
                else
                {
                    @if (lesson.EmbedUrl is not null)
                    {
                        @if (lesson.IsDirectVideo)
                        {
                            <video id="@VideoElementId" class="w-100 rounded mb-4" style="max-height: 500px;" controls preload="metadata">
                                <source src="@lesson.EmbedUrl" />
                            </video>
                        }
                        else
                        {
                            <div class="ratio ratio-16x9 mb-4">
                                <iframe id="@VideoElementId" src="@PlayerEmbedUrl"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen
                                        class="rounded border-0"></iframe>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary">Esta lección no tiene video.</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(lesson.Content))
                    {
                        <p class="mt-3">@lesson.Content</p>
                    }
                }

                @if (progress is not null)
                {
                    @if (progressError is not null)
                    {
                        <div class="alert alert-danger py-2 small mt-3">@progressError</div>
                    }
                    <div class="mt-3 d-flex gap-2">
                        @if (progress.IsCompleted)
                        {
                            <button class="btn btn-outline-success" disabled="@isUpdatingProgress" @onclick="HandleUnmarkCompleteAsync">
                                ✓ Completada — clic para desmarcar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success" disabled="@isUpdatingProgress" @onclick="HandleMarkCompleteAsync">
                                @(isUpdatingProgress ? "Guardando..." : "Marcar como completada")
                            </button>
                        }

                        @if (NextLesson is not null)
                        {
                            <button class="btn btn-outline-primary" disabled="@isUpdatingProgress" @onclick="HandleGoToNextLessonAsync">
                                Siguiente lección →
                            </button>
                        }
                    </div>
                }
            </div>

            @if (courseLessons is not null)
            {
                <div class="col-lg-4">
                    <div class="card shadow-sm">
                        <div class="card-header fw-semibold">Lecciones del curso</div>
                        <div class="list-group list-group-flush">
                            @foreach (var item in courseLessons)
                            {
                                var isCurrent = item.LessonId == LessonId;
                                <a href="/cursos/@CourseId/lecciones/@item.LessonId"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isCurrent ? "active" : "") @(item.IsCompleted && !isCurrent ? "list-group-item-success" : "")">
                                    <span class="small">@item.Order. @item.LessonTitle</span>
                                    @if (item.IsCompleted)
                                    {
                                        <span>✓</span>
                                    }
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public Guid LessonId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const string VideoElementId = "lesson-video-player";

    private LessonDetailDto? lesson;
    private LessonProgressDto? progress;
    private List<LessonProgressListItemDto>? courseLessons;
    private bool isLoading = true;
    private bool isUpdatingProgress;
    private string? progressError;
    private Guid? loadedLessonId;
    private bool needsVideoWatchSetup;
    private DotNetObjectReference<LessonPlayerPage>? dotNetRef;

    private LessonProgressListItemDto? NextLesson
    {
        get
        {
            if (courseLessons is null) return null;
            var currentIndex = courseLessons.FindIndex(l => l.LessonId == LessonId);
            return currentIndex >= 0 && currentIndex + 1 < courseLessons.Count
                ? courseLessons[currentIndex + 1]
                : null;
        }
    }

    private string PlayerEmbedUrl
    {
        get
        {
            if (lesson?.EmbedUrl is null || lesson.IsDirectVideo)
                return lesson?.EmbedUrl ?? string.Empty;

            if (lesson.EmbedUrl.Contains("youtube.com", StringComparison.OrdinalIgnoreCase))
            {
                var separator = lesson.EmbedUrl.Contains('?') ? "&" : "?";
                return $"{lesson.EmbedUrl}{separator}enablejsapi=1";
            }

            return lesson.EmbedUrl;
        }
    }

    // OnParametersSetAsync (no solo OnInitializedAsync): al navegar de una lección a otra dentro
    // de la misma página (botón "Siguiente lección"), Blazor reutiliza esta instancia del
    // componente en vez de recrearla — hay que recargar los datos cuando cambia LessonId.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedLessonId == LessonId)
            return;

        loadedLessonId = LessonId;
        isLoading = true;
        progress = null;
        courseLessons = null;
        progressError = null;

        lesson = await Api.GetLessonDetailAsync(LessonId);
        isLoading = false;

        var isAuthenticated = false;
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }

        if (isAuthenticated && lesson is not null)
        {
            // Null significa "no inscrito" o error — el botón/menú se oculta en ese caso.
            progress = await Api.GetLessonProgressAsync(LessonId);

            if (progress is not null)
                courseLessons = await Api.GetCourseLessonProgressAsync(CourseId);
        }

        if (progress is not null && lesson?.EmbedUrl is not null)
            needsVideoWatchSetup = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsVideoWatchSetup)
        {
            needsVideoWatchSetup = false;
            await InitializeVideoEndDetectionAsync();
        }
    }

    private async Task InitializeVideoEndDetectionAsync()
    {
        if (lesson?.EmbedUrl is null)
            return;

        dotNetRef?.Dispose();
        dotNetRef = DotNetObjectReference.Create(this);

        if (lesson.IsDirectVideo)
        {
            await JS.InvokeVoidAsync("videoProgress.watchDirectVideo", VideoElementId, dotNetRef);
        }
        else if (lesson.EmbedUrl.Contains("youtube.com", StringComparison.OrdinalIgnoreCase))
        {
            await JS.InvokeVoidAsync("videoProgress.watchYoutube", VideoElementId, dotNetRef);
        }
        else if (lesson.EmbedUrl.Contains("vimeo.com", StringComparison.OrdinalIgnoreCase))
        {
            await JS.InvokeVoidAsync("videoProgress.watchVimeo", VideoElementId, dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnVideoEndedFromJs()
    {
        if (progress is null || progress.IsCompleted)
            return;

        await CompleteAndAdvanceAsync();
        StateHasChanged();
    }

    private async Task HandleMarkCompleteAsync()
    {
        await CompleteAndAdvanceAsync();
    }

    private async Task CompleteAndAdvanceAsync()
    {
        isUpdatingProgress = true;
        progressError = null;

        var (success, error) = await Api.MarkLessonCompleteAsync(LessonId);

        isUpdatingProgress = false;

        if (!success)
        {
            progressError = error;
            return;
        }

        progress = progress! with { IsCompleted = true, CompletedAt = DateTimeOffset.UtcNow };

        var nextLesson = NextLesson;
        Nav.NavigateTo(nextLesson is not null
            ? $"/cursos/{CourseId}/lecciones/{nextLesson.LessonId}"
            : $"/cursos/{CourseId}");
    }

    private async Task HandleUnmarkCompleteAsync()
    {
        isUpdatingProgress = true;
        progressError = null;

        var (success, error) = await Api.UnmarkLessonCompleteAsync(LessonId);

        isUpdatingProgress = false;

        if (success)
            progress = progress! with { IsCompleted = false, CompletedAt = null };
        else
            progressError = error;
    }

    private Task HandleGoToNextLessonAsync()
    {
        var nextLesson = NextLesson;
        if (nextLesson is not null)
            Nav.NavigateTo($"/cursos/{CourseId}/lecciones/{nextLesson.LessonId}");

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("videoProgress.dispose");
        }
        catch (JSDisconnectedException)
        {
            // El circuito ya se cerró (navegación fuera de la app) — nada que limpiar.
        }
    }
}
