@page "/forgot-password"
@layout AuthLayout

@inject PublicApiService Api

<PageTitle>Recuperar contraseña — Dance Academy</PageTitle>

<div class="da-auth-card">
    <div class="text-center mb-4">
        <img src="logo.svg" width="52" height="52" alt="Dance Academy" class="mb-3" />
        <h5 class="fw-bold mb-1">Recuperar contraseña</h5>
        <p class="text-muted small mb-0">Te enviaremos un enlace a tu email</p>
    </div>

    @if (successMessage is not null)
    {
        <div class="alert alert-success py-2 small">@successMessage</div>
        <p class="text-center text-muted small mt-3 mb-0">
            <a href="/login">Volver al inicio de sesión</a>
        </p>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger py-2 small">@errorMessage</div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleForgotPasswordAsync">
            <div class="mb-4">
                <label class="form-label fw-medium small">Email</label>
                <input type="email" class="form-control" @bind="model.Email"
                       autocomplete="email" placeholder="tu@email.com" />
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" disabled="@isLoading">
                @(isLoading ? "Enviando..." : "Enviar enlace")
            </button>
        </EditForm>

        <p class="text-center text-muted small mt-4 mb-0">
            <a href="/login">Volver al inicio de sesión</a>
        </p>
    }
</div>

@code {
    private readonly ForgotModel model = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Email))
        {
            errorMessage = "Ingresa tu email.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        var (success, error) = await Api.ForgotPasswordAsync(model.Email);

        isLoading = false;

        if (success)
            successMessage = "Si el email está registrado, recibirás un enlace en los próximos minutos.";
        else
            errorMessage = error;
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
