@inject AuthApiService AuthService
@inject NavigationManager Nav

<div class="d-flex flex-column bg-dark text-white" style="width: 220px; min-width: 220px;">
    <div class="px-3 py-4 border-bottom border-secondary">
        <div class="d-flex align-items-center gap-2 mb-1">
            <img src="logo.png" width="34" height="34" alt="Dance Academy" />
            <span class="fw-semibold">Dance Academy</span>
        </div>
        <small class="text-secondary ms-1">Panel Admin</small>
    </div>

    <nav class="flex-grow-1 py-2">
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/dashboard" Match="NavLinkMatch.All">
            Dashboard
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/courses" Match="NavLinkMatch.Prefix">
            Cursos
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/levels" Match="NavLinkMatch.Prefix">
            Niveles
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/plans" Match="NavLinkMatch.Prefix">
            Planes
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/students" Match="NavLinkMatch.Prefix">
            Estudiantes
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/instructors" Match="NavLinkMatch.Prefix">
            Instructores
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/testimonials" Match="NavLinkMatch.Prefix">
            Testimonios
        </NavLink>
        <NavLink class="nav-link text-white px-3 py-2 d-block" href="/faq" Match="NavLinkMatch.Prefix">
            FAQ
        </NavLink>
    </nav>

    <div class="px-3 py-3 border-top border-secondary">
        <button class="btn btn-sm btn-outline-secondary w-100" @onclick="HandleLogoutAsync">
            Cerrar sesión
        </button>
    </div>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
