server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # SPA (Blazor WebAssembly): cualquier ruta que no sea un archivo real cae a index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # No declarar un bloque "types { }" propio: reemplaza por completo la tabla MIME
    # por defecto de nginx (incluida globalmente vía mime.types), dejando TODO —
    # incluido .html— como application/octet-stream. Eso hace que el navegador intente
    # descargar la página en vez de mostrarla. La tabla por defecto de nginx ya
    # incluye .wasm correctamente, así que no hace falta tocarla.
}
