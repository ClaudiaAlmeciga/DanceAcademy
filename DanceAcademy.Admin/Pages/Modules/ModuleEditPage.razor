@page "/courses/{courseId:guid}/modules/{moduleId:guid}/edit"
@attribute [Authorize(Roles = "Admin")]

@inject AdminApiService AdminApi
@inject NavigationManager Nav

<PageTitle>Editar módulo — Dance Academy Admin</PageTitle>

<div class="mb-3">
    <a href="/courses/@CourseId" class="text-decoration-none text-muted small">← Volver al curso</a>
</div>

@if (isLoading)
{
    <div class="text-center py-5 text-muted">Cargando...</div>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else
{
    <div class="card shadow-sm" style="max-width: 520px;">
        <div class="card-body">
            <h5 class="card-title mb-4">Editar módulo</h5>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger py-2 small">@errorMessage</div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleSubmitAsync">
                <div class="mb-3">
                    <label class="form-label">Título <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="model.Title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Orden <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" @bind="model.Order" min="1" style="max-width: 120px;" />
                    <div class="form-text">Posición del módulo dentro del curso.</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar cambios")
                    </button>
                    <a href="/courses/@CourseId" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid CourseId { get; set; }
    [Parameter] public Guid ModuleId { get; set; }

    private readonly ModuleEditModel model = new();
    private string? loadError;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var course = await AdminApi.GetCourseDetailAsync(CourseId);
            if (course is null)
            {
                loadError = "Curso no encontrado.";
                return;
            }

            var module = course.Modules.FirstOrDefault(m => m.Id == ModuleId);
            if (module is null)
            {
                loadError = "Módulo no encontrado.";
                return;
            }
            if (module.IsPublished)
            {
                Nav.NavigateTo($"/courses/{CourseId}", replace: true);
                return;
            }
            model.Title = module.Title;
            model.Order = module.Order;
        }
        catch
        {
            loadError = "No se pudo cargar el módulo.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Title))
        {
            errorMessage = "El título es obligatorio.";
            return;
        }
        if (model.Order < 1)
        {
            errorMessage = "El orden debe ser >= 1.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        var request = new UpdateModuleRequest(model.Title.Trim(), model.Order);
        var response = await AdminApi.UpdateModuleAsync(ModuleId, request);

        isSaving = false;

        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo($"/courses/{CourseId}");
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            errorMessage = $"Ya existe un módulo con orden {model.Order} en este curso.";
        }
        else
        {
            errorMessage = $"Error al guardar (HTTP {(int)response.StatusCode}).";
        }
    }

    private sealed class ModuleEditModel
    {
        public string Title { get; set; } = string.Empty;
        public int Order { get; set; } = 1;
    }
}
