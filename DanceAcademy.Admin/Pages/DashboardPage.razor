@page "/dashboard"
@attribute [Authorize(Roles = "Admin")]

@inject AdminApiService AdminApi

<PageTitle>Dashboard — Dance Academy Admin</PageTitle>

<h4 class="mb-4">Dashboard</h4>

@if (isLoading)
{
    <div class="text-center py-5 text-muted">Cargando...</div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Estudiantes</div>
                    <div class="fs-3 fw-bold">@summary?.TotalStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Cursos publicados</div>
                    <div class="fs-3 fw-bold">@summary?.TotalPublishedCourses</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Inscripciones totales</div>
                    <div class="fs-3 fw-bold">@summary?.TotalEnrollments</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Avance promedio</div>
                    <div class="fs-3 fw-bold">@(summary?.AverageCompletionRate.ToString("0.#"))%</div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="mb-3">Cursos por popularidad</h5>

    @if (courseStats is null || courseStats.Count == 0)
    {
        <div class="text-muted small">Todavía no hay cursos publicados con inscripciones.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Curso</th>
                            <th>Inscritos</th>
                            <th>Avance promedio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in courseStats)
                        {
                            <tr>
                                <td class="align-middle">
                                    <a href="/courses/@course.CourseId">@course.CourseTitle</a>
                                </td>
                                <td class="align-middle">@course.EnrollmentCount</td>
                                <td class="align-middle" style="max-width: 240px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @(course.AverageCompletionRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        <span class="small text-muted">@course.AverageCompletionRate.ToString("0.#")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private AdminDashboardSummaryDto? summary;
    private List<AdminCourseStatsDto>? courseStats;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await AdminApi.GetDashboardSummaryAsync();
            courseStats = await AdminApi.GetCourseStatsAsync();
        }
        catch
        {
            errorMessage = "No se pudo cargar el dashboard.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
