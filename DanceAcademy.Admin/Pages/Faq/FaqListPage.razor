@page "/faq"
@attribute [Authorize(Roles = "Admin")]

@inject AdminApiService AdminApi

<PageTitle>FAQ — Dance Academy Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Preguntas frecuentes</h4>
    <a class="btn btn-primary btn-sm" href="/faq/new">+ Nueva pregunta</a>
</div>

@if (isLoading)
{
    <div class="text-center py-5 text-muted">Cargando...</div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (items is not null)
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Categoría</th>
                        <th>Orden</th>
                        <th>Pregunta</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="align-middle">@item.Category</td>
                            <td class="align-middle">@item.Order</td>
                            <td class="align-middle">@item.Question</td>
                            <td class="align-middle">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>
                            <td class="align-middle text-end">
                                @if (confirmingFaqId == item.Id)
                                {
                                    <span class="small text-danger me-2">¿Eliminar?</span>
                                    <button class="btn btn-sm btn-danger me-1"
                                            @onclick="() => HandleDeleteFaqAsync(item.Id)"
                                            disabled="@isBusy">
                                        Sí
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => confirmingFaqId = null">
                                        No
                                    </button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-secondary me-1" href="/faq/@item.Id/edit">
                                        Editar
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => confirmingFaqId = item.Id"
                                            disabled="@isBusy">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!items.Any())
        {
            <div class="text-center py-4 text-muted">
                No hay preguntas frecuentes. <a href="/faq/new">Crea la primera.</a>
            </div>
        }
    </div>
}

@code {
    private List<AdminFaqItemDto>? items;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isBusy;
    private Guid? confirmingFaqId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await AdminApi.GetFaqItemsAsync();
        }
        catch
        {
            errorMessage = "No se pudo cargar la lista de preguntas frecuentes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDeleteFaqAsync(Guid faqItemId)
    {
        isBusy = true;
        confirmingFaqId = null;
        var response = await AdminApi.DeleteFaqItemAsync(faqItemId);
        isBusy = false;

        if (response.IsSuccessStatusCode)
            items = items?.Where(i => i.Id != faqItemId).ToList();
        else
            errorMessage = "No se pudo eliminar la pregunta.";
    }
}
