@page "/courses/new"
@attribute [Authorize(Roles = "Admin")]

@inject AdminApiService AdminApi
@inject NavigationManager Nav

<PageTitle>Nuevo curso — Dance Academy Admin</PageTitle>

<div class="mb-3">
    <a href="/courses" class="text-decoration-none text-muted small">← Volver a cursos</a>
</div>

<div class="card shadow-sm" style="max-width: 520px;">
    <div class="card-body">
        <h5 class="card-title mb-4">Nuevo curso</h5>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger py-2 small">@errorMessage</div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleSubmitAsync">
            <div class="mb-3">
                <label class="form-label">Título <span class="text-danger">*</span></label>
                <input class="form-control" @bind="model.Title" placeholder="Ej: Salsa Principiantes" />
            </div>
            <div class="mb-3">
                <label class="form-label">Nivel <span class="text-danger">*</span></label>
                <select class="form-select" @bind="model.LevelId">
                    @if (levels is not null)
                    {
                        @foreach (var level in levels)
                        {
                            <option value="@level.Id">@level.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea class="form-control" rows="3" @bind="model.Description"
                          placeholder="Descripción del curso (opcional)"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">URL de imagen de portada</label>
                <input class="form-control" @bind="model.ImageUrl" placeholder="https://..." />
            </div>
            <div class="mb-3">
                <label class="form-label">Duración estimada (horas)</label>
                <input type="number" min="1" step="1" class="form-control" style="max-width: 160px;" @bind="model.DurationHours" />
            </div>
            <div class="mb-3">
                <label class="form-label">Tipo de precio <span class="text-danger">*</span></label>
                <select class="form-select" @bind="model.PricingType">
                    <option value="@PricingType.Free">Gratis</option>
                    <option value="@PricingType.IndividualPurchase">Compra individual</option>
                    <option value="@PricingType.SubscriptionIncluded">Incluido en suscripción</option>
                    <option value="@PricingType.Both">Compra individual o suscripción</option>
                </select>
            </div>
            @if (RequiresPrice(model.PricingType))
            {
                <div class="mb-3">
                    <label class="form-label">Precio <span class="text-danger">*</span></label>
                    <input type="number" min="0.01" step="0.01" class="form-control" style="max-width: 200px;" @bind="model.Price" />
                </div>
            }
            @if (AllowsPlans(model.PricingType) && plans is not null)
            {
                <div class="mb-3">
                    <label class="form-label">Planes que incluyen este curso</label>
                    @if (!plans.Any())
                    {
                        <div class="text-muted small">No hay planes creados. <a href="/plans/new" target="_blank">Crea uno</a>.</div>
                    }
                    else
                    {
                        @foreach (var plan in plans)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="plan-@plan.Id"
                                       checked="@model.SubscriptionPlanIds.Contains(plan.Id)"
                                       @onchange="e => TogglePlan(plan.Id, (bool)e.Value!)" />
                                <label class="form-check-label" for="plan-@plan.Id">@plan.Name</label>
                            </div>
                        }
                    }
                </div>
            }
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                    @(isLoading ? "Guardando..." : "Crear curso")
                </button>
                <a href="/courses" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly CourseCreateModel model = new();
    private List<AdminLevelDto>? levels;
    private List<AdminSubscriptionPlanDto>? plans;
    private string? errorMessage;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        levels = await AdminApi.GetLevelsAsync();
        if (levels is { Count: > 0 })
            model.LevelId = levels[0].Id;

        plans = await AdminApi.GetSubscriptionPlansAsync();
    }

    private void TogglePlan(Guid planId, bool isChecked)
    {
        if (isChecked) model.SubscriptionPlanIds.Add(planId);
        else model.SubscriptionPlanIds.Remove(planId);
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Title))
        {
            errorMessage = "El título es obligatorio.";
            return;
        }

        var price = RequiresPrice(model.PricingType) ? model.Price : null;
        if (RequiresPrice(model.PricingType) && (price is null || price <= 0))
        {
            errorMessage = "El precio debe ser mayor a 0 para este tipo.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        var planIds = AllowsPlans(model.PricingType) ? model.SubscriptionPlanIds.ToList() : new List<Guid>();
        var request = new CreateCourseRequest(model.Title.Trim(), model.LevelId, model.Description?.Trim(), model.PricingType, price, planIds, model.ImageUrl, model.DurationHours);
        var response = await AdminApi.CreateCourseAsync(request);

        isLoading = false;

        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/courses");
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            errorMessage = "Ya existe un curso con ese título.";
        }
        else
        {
            errorMessage = $"Error al crear el curso (HTTP {(int)response.StatusCode}). Intenta de nuevo.";
        }
    }

    private static bool RequiresPrice(PricingType pricingType) =>
        pricingType is PricingType.IndividualPurchase or PricingType.Both;

    private static bool AllowsPlans(PricingType pricingType) =>
        pricingType is PricingType.SubscriptionIncluded or PricingType.Both;

    private sealed class CourseCreateModel
    {
        public string Title { get; set; } = string.Empty;
        public Guid LevelId { get; set; }
        public string? Description { get; set; }
        public string? ImageUrl { get; set; }
        public int? DurationHours { get; set; }
        public PricingType PricingType { get; set; } = PricingType.Free;
        public decimal? Price { get; set; }
        public HashSet<Guid> SubscriptionPlanIds { get; set; } = new();
    }
}
