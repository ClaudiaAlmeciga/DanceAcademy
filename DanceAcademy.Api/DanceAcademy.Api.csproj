<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>false</PublishAot>
    <UserSecretsId>6ca1c84e-4a5f-4ce4-82e5-b20664a01908</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DanceAcademy.Application\DanceAcademy.Application.csproj" />
    <ProjectReference Include="..\DanceAcademy.Infrastructure\DanceAcademy.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Solo en desarrollo local en Windows (F5 en Visual Studio): asegura que Docker Desktop y la
       base de datos estén levantados antes de correr la API. No afecta al CI (Ubuntu, Release). -->
  <Target Name="EnsureLocalDbRunning" BeforeTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(Configuration)' == 'Debug'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\scripts\start-db.ps1&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
